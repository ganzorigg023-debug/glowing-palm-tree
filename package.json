<!DOCTYPE html>
<html lang="mn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Хувь хүн ба эдийн засаг</title>
</head>
<body>

<h1>ХУВЬ ХҮН БА ЭДИЙН ЗАСАГ</h1>

<div id="login">

<h3>Нэвтрэх</h3>

<input id="username" placeholder="Нэвтрэх нэр">

<input id="password" type="password" placeholder="Нууц код">

<button onclick="login()">
Нэвтрэх
</button>

</div>

<div id="quiz" style="display:none;">

<h3>1. Эдийн засаг гэж юу вэ?</h3>

<label>
<input type="radio" name="q1" value="correct">
Хязгааргүй хэрэгцээг хязгаарлагдмал нөөцөөр хангахыг судална
</label>

<br><br>

<label>
<input type="radio" name="q1" value="wrong">
Хүний биеийг судална
</label>

<br><br>

<button onclick="finishQuiz()">
Шалгалт дуусгах
</button>

<div id="result"></div>

</div>

<script>

const USERNAME = "student43";
const PASSWORD = "4589";

function login(){

const user =
document.getElementById("username").value;

const pass =
document.getElementById("password").value;

if(
user === USERNAME &&
pass === PASSWORD
){

document.getElementById("login").style.display="none";
document.getElementById("quiz").style.display="block";

}else{

alert("Нэвтрэх мэдээлэл буруу байна");

}

}

function finishQuiz(){

let score = 0;

const q1 =
document.querySelector(
'input[name="q1"]:checked'
);

if(q1 && q1.value==="correct"){
score++;
}

document.getElementById("result").innerHTML =
"Таны оноо: " + score;

}

</script>

</body>
</html>
